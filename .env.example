# ── HariKita - Environment Example (template) ────────────────────────────────
# Salin menjadi `.env` lalu isi nilainya. JANGAN commit `.env` asli.

# ── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite lokal):
DATABASE_URL="file:./dev.db"
# Produksi / cloud (contoh — pindah provider ke "postgresql" di schema.prisma):
# DATABASE_URL="postgresql://user:pass@host:5432/harikita?sslmode=require"
# Turso (libSQL) — butuh driver adapter @prisma/adapter-libsql:
# DATABASE_URL="libsql://<db>-<org>.turso.io?authToken=<token>"

# ── Payment Gateway ──────────────────────────────────────────────────────────
# Provider aktif: simulated_qris | midtrans | xendit
HARIKITA_PAYMENT_PROVIDER="simulated_qris"

# Secret verifikasi webhook mode simulated_qris (kosong = sandbox eksplisit).
HARIKITA_WEBHOOK_SECRET=""

# Secret endpoint cron: /api/cron/sweep?secret=... atau header x-cron-secret.
# Di Vercel: set CRON_SECRET (dikirim otomatis sebagai Authorization Bearer oleh Vercel Cron).
HARIKITA_CRON_SECRET="change-me"

# Midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Xendit
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""

# ── Base URL (untuk tautan pembayaran) ───────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── SEO & Analytics (Phase 8) ────────────────────────────────────────────────
# Canonical URL publik dipakai untuk metadata, sitemap, robots & OG.
# Di produksi isi dengan domain final tanpa trailing slash.
# (menggunakan NEXT_PUBLIC_BASE_URL di atas)

# Google Analytics 4 (opsional) — format: G-XXXXXXXXXX. Kosongkan untuk menonaktifkan.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Umami analytics (opsional, alternatif GA4). Kosongkan untuk menonaktifkan.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
NEXT_PUBLIC_UMAMI_SRC="https://analytics.umami.is/script.js"
