# ── HariKita - Environment Example (template) ────────────────────────────────
# Salin menjadi `.env` lalu isi nilainya. JANGAN commit `.env` asli.

# ── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
# Sumber kebenaran produksi = PostgreSQL (prisma/schema.prisma).
# Development & test memakai SQLite (prisma/schema.sqlite.prisma) — lihat scripts.
#
# Supabase → Project Settings → Database → Connection string.
# Gunakan CONNECTION POOLER (port 6543) untuk Vercel/serverless:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Koneksi langsung (port 5432) untuk MIGRASI (tanpa pooler):
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ── Payment Gateway ──────────────────────────────────────────────────────────
# Provider aktif: simulated_qris | midtrans | xendit
HARIKITA_PAYMENT_PROVIDER="midtrans"

# Midtrans (Snap — halaman pembayaran lengkap)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SNAP_ENABLED="true"

# Secret verifikasi webhook mode simulated_qris (kosong = sandbox eksplisit).
HARIKITA_WEBHOOK_SECRET=""

# ── Cron ─────────────────────────────────────────────────────────────────────
# Vercel Cron mengirim Authorization: Bearer <CRON_SECRET> otomatis bila di-set.
CRON_SECRET="change-me"

# ── Xendit (opsional) ────────────────────────────────────────────────────────
# XENDIT_SECRET_KEY="xnd_development_xxxxxxxx"
# XENDIT_CALLBACK_TOKEN="xxxxxxxx"

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Untuk produksi: NEXT_PUBLIC_BASE_URL="https://<domain-anda>"

# ── Email OTP (Resend) ────────────────────────────────────────────────────────
# Kosongkan RESEND_API_KEY saat dev → OTP dicetak ke console + banner dev.
RESEND_API_KEY=""
OTP_EMAIL_FROM="HariKita <onboarding@resend.dev>"
# "true" saat dev: jangan kirim email asli, tampilkan kode di UI/console.
OTP_DEV_MODE="true"
