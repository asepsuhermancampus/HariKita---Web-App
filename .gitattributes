# HariKita - Git attributes
#
# Menstabilkan line-ending antar mesin (Windows/Linux) sehingga file teks tidak
# muncul sebagai "modified" palsu hanya karena perbedaan CRLF vs LF.
#
# Strategi: normalisasi semua file teks ke LF di repositori. Git tetap menyimpan
# LF; pada checkout Windows, editor modern menanganinya dengan baik. Ini membuat
# `git status` bersih dan diff konsisten.

# Default: deteksi otomatis, normalisasi ke LF di repo.
* text=auto eol=lf

# Sumber kode & konfigurasi teks → LF eksplisit.
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.prisma text eol=lf
*.sql   text eol=lf
*.env   text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Skrip shell → wajib LF agar tetap dapat dieksekusi di Unix.
*.sh text eol=lf

# Skrip Windows → CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Aset biner → jangan disentuh (tanpa konversi line-ending).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.mp3  binary
*.mp4  binary
*.pdf  binary
*.db   binary
*.zip  binary

# Linguist: tandai file generated agar tidak mengacaukan statistik bahasa.
package-lock.json linguist-generated=true
src/data/harikita-assets.json linguist-generated=true

# Saat merge, gunakan strategi union untuk file changelog bila ada.
CHANGELOG.md merge=union
