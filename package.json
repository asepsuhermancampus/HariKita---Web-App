{
  "name": "harikita-web-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev_runner.js",
    "dev:next": "next dev",
    "prebuild": "node scripts/generate_asset_manifest.js && node scripts/verify_assets_complete.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate": "prisma validate",
    "generate": "prisma generate",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm run validate && npm run test",
    "assets:manifest": "node scripts/generate_asset_manifest.js && node scripts/verify_assets_complete.js",
    "assets:verify": "node scripts/verify_assets_complete.js",
    "assets:watch": "node scripts/watch_assets.js",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "daisyui": "^4.12.23",
    "embla-carousel-react": "^8.5.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "potrace": "^2.1.8",
    "prisma": "^6.1.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
